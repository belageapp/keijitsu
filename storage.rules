rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function userData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function isActive() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && userData().get('disabled', false) != true
        && userData().get('status', 'active') != 'pending';
    }
    function isEditor() {
      return isActive() && (userData().get('role','member') == 'editor' || userData().get('role','member') == 'admin');
    }

    // イベントの添付（チラシ・資料）：閲覧は会員、書き込みは editor 以上
    match /events/{eventId}/{fileName=**} {
      allow read: if isActive();
      allow write: if isEditor() && request.resource.size < 15 * 1024 * 1024;
    }

    // ユーザーの顔写真：閲覧は会員、書き込みは本人 or admin
    match /users/{userId}/{fileName=**} {
      allow read: if isActive();
      allow write: if isActive()
        && (request.auth.uid == userId || userData().role == 'admin')
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
