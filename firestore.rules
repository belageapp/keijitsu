rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // 権限モデル
    //   member（一般）/ editor（編集者）/ admin（管理者）
    // ============================================================
    function isAuth() {
      return request.auth != null;
    }
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActive() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userData().get('disabled', false) != true
        && userData().get('status', 'active') != 'pending';   // 承認待ちは不可（statusなし=active扱い）
    }
    function role() {
      return userData().role;
    }
    function isEditor() {
      return isActive() && (role() == 'editor' || role() == 'admin');
    }
    function isAdmin() {
      return isActive() && role() == 'admin';
    }

    // ── users ──────────────────────────────────────────────
    // 閲覧：ログイン済み会員全員
    // 作成・権限/状態変更：admin のみ
    // 本人：基本情報・志・事業内容・紹介者・写真は編集可（role/disabledは変更不可）
    match /users/{userId} {
      // 自分のドキュメントは承認待ちでも読める（他人の閲覧は active 会員のみ）
      allow read: if isAuth() && (request.auth.uid == userId || isActive());

      // admin による作成、または本人による自己登録（member・inviterなし 固定）
      // ※テスト運用中：承認不要のため自己登録を status=='active' で許可。
      //   承認制に戻すときは 'active' → 'pending' に戻す（register.html 側も同時に要変更）。
      allow create: if isAdmin()
        || (isAuth() && request.auth.uid == userId
            && request.resource.data.role == 'member'
            && request.resource.data.status == 'active'
            && request.resource.data.disabled == false
            && request.resource.data.get('inviterUid', null) == null
            && request.resource.data.get('uid', userId) == userId);
      allow delete: if isAdmin();

      // 本人が編集できるのは以下のプロフィール項目のみ（role/status/disabled/inviterUid等は不可）
      allow update: if isActive() && (
        isAdmin()
        || (request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'name','nameKana','sei','mei','seiKana','meiKana',
                 'companyName','title','aspiration','businessContent',
                 'companies','industries','introducerUid','photoURL'
               ]))
        // editor：他人の声かけ者(inviterUid)のみ設定可
        || (isEditor()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inviterUid']))
      );
    }

    // ── events ─────────────────────────────────────────────
    // 閲覧：誰でも（ログイン不要。2026-10-27 代表の決定）／作成・削除・編集：editor 以上
    // 例外：参加人数の集計(summary)フィールドのみ、会員も更新可（出欠登録時の自動集計用）
    // ※ 出欠(attendance)サブコレクションは従来どおり会員のみ
    match /events/{eventId} {
      allow read: if true;
      allow create, delete: if isEditor();
      allow update: if isEditor()
        || (isActive()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['summary']));

      // 出欠サブコレクション
      //   本人：自分の status 等を登録可
      //   editor：他人の声かけ者(inviterUid)を上書き可
      match /attendance/{uid} {
        allow read: if isActive();
        allow write: if isActive() && (uid == request.auth.uid || isEditor());
      }
    }

    // ── リーダーMT ダッシュボード（dashboard.html、2026-11-25 代表の決定）──
    // 実行委員長・副（名前が入る）：ログインした会員が閲覧／editor 以上が編集
    // ※ テスト中（USER 2026-11-26）は未ログインでも読める。本運用で戻すときは read を isActive() に
    match /eventStaff/{eventId} {
      allow read: if true;
      allow write: if isEditor();
    }
    // 新入会の方の進み具合（氏名が入る）：editor 以上だけ
    // ※ テスト中（USER 2026-11-26）は未ログインでも読める。本運用で戻すときは read を isEditor() に
    match /newMembers/{id} {
      allow read: if true;
      allow write: if isEditor();
    }
    // 今週の宿題（担当の名前が入る）：ログインした会員が閲覧／editor 以上が編集
    // ※ テスト中（USER 2026-11-26）は未ログインでも読める。本運用で戻すときは read を isActive() に
    match /mtTasks/{id} {
      allow read: if true;
      allow write: if isEditor();
    }
    // 公開してよい集計（新入会の人数だけ。名前は入れない）：誰でも閲覧／editor 以上が書く
    match /dashboard/{docId} {
      allow read: if true;
      allow write: if isEditor();
    }
  }
}
