rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // 権限モデル
    //   member（一般）/ editor（編集者）/ admin（管理者）
    // ============================================================
    function isAuth() {
      return request.auth != null;
    }
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActive() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userData().get('disabled', false) != true
        && userData().get('status', 'active') != 'pending';   // 承認待ちは不可（statusなし=active扱い）
    }
    function role() {
      return userData().role;
    }
    function isEditor() {
      return isActive() && (role() == 'editor' || role() == 'admin');
    }
    function isAdmin() {
      return isActive() && role() == 'admin';
    }

    // ── users ──────────────────────────────────────────────
    // 閲覧：ログイン済み会員全員
    // 作成・権限/状態変更：admin のみ
    // 本人：基本情報・志・事業内容・紹介者・写真は編集可（role/disabledは変更不可）
    match /users/{userId} {
      // 自分のドキュメントは承認待ちでも読める（他人の閲覧は active 会員のみ）
      allow read: if isAuth() && (request.auth.uid == userId || isActive());

      // admin による作成、または本人による自己登録（member・pending・inviterなし 固定）
      allow create: if isAdmin()
        || (isAuth() && request.auth.uid == userId
            && request.resource.data.role == 'member'
            && request.resource.data.status == 'pending'
            && request.resource.data.disabled == false
            && request.resource.data.get('inviterUid', null) == null
            && request.resource.data.get('uid', userId) == userId);
      allow delete: if isAdmin();

      // 本人が編集できるのは以下のプロフィール項目のみ（role/status/disabled/inviterUid等は不可）
      allow update: if isActive() && (
        isAdmin()
        || (request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'name','nameKana','sei','mei','seiKana','meiKana',
                 'companyName','title','aspiration','businessContent',
                 'companies','industries','introducerUid','photoURL'
               ]))
        // editor：他人の声かけ者(inviterUid)のみ設定可
        || (isEditor()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inviterUid']))
      );
    }

    // ── events ─────────────────────────────────────────────
    // 閲覧：会員全員／作成・削除・編集：editor 以上
    // 例外：参加人数の集計(summary)フィールドのみ、会員も更新可（出欠登録時の自動集計用）
    match /events/{eventId} {
      allow read: if isActive();
      allow create, delete: if isEditor();
      allow update: if isEditor()
        || (isActive()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['summary']));

      // 出欠サブコレクション
      //   本人：自分の status 等を登録可
      //   editor：他人の声かけ者(inviterUid)を上書き可
      match /attendance/{uid} {
        allow read: if isActive();
        allow write: if isActive() && (uid == request.auth.uid || isEditor());
      }
    }
  }
}
